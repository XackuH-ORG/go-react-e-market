# Режим работы приложения: local, dev, prod
ENV=local

# ==========================================
# Настройки HTTP сервера
# ==========================================
# Адрес и порт, на котором будет запущен сервер
HTTP_ADDR=0.0.0.0:8080
# Таймаут на чтение запроса (например: 4s, 1m)
HTTP_READ_TIMEOUT=4s
# Таймаут на запись ответа (например: 4s, 1m)
HTTP_WRITE_TIMEOUT=4s
# Время простоя перед закрытием соединения (например: 60s, 5m)
HTTP_IDLE_TIMEOUT=60s
# Общий таймаут обработки запроса
HTTP_REQ_TIMEOUT=60s

# ==========================================
# Настройки базы данных (Postgres)
# ==========================================
# Драйвер базы данных
GOOSE_DRIVER=postgres
# DSN строка для подключения к Postgres
# Формат: postgres://user:password@host:port/dbname?sslmode=disable
GOOSE_DBSTRING=postgres://postgres:admin@localhost:5432/emarket?sslmode=disable

# ==========================================
# Настройки аутентификации (JWT)
# ==========================================
# Секретный ключ для подписи JWT токенов (минимум 32 символа для безопасности)
JWT_SECRET=super-secret-key-for-jwt-tokens-change-in-prod
# Время жизни access токена (например: 15m, 1h)
JWT_TTL=1h