{
  "hooks": [
    {
      "event": "after_file_edit",
      "pattern": "**/*.go",
      "action": "shell",
      "command": "go fmt {{file}} && goimports -w {{file}}"
    },
    {
      "event": "after_file_edit",
      "pattern": "internal/adapters/postgresql/sqlc/**/*.sql",
      "action": "shell",
      "command": "sqlc generate"
    },
    {
      "event": "after_file_edit",
      "pattern": "frontend/src/**/*.{ts,tsx}",
      "action": "shell",
      "command": "cd frontend && npx prettier --write {{file}}"
    },
    {
      "event": "after_file_edit",
      "pattern": "internal/**/*.go",
      "action": "shell",
      "command": "go test -race -v ./$(dirname {{file}}) && go vet ./..."
    },
    {
      "event": "after_file_edit",
      "pattern": "frontend/src/**/*.{ts,tsx}",
      "action": "shell",
      "command": "cd frontend && npx tsc --noEmit && npx vitest run --passWithNoTests"
    }
  ]
}
